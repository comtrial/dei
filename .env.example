# 원격 Supabase 프로젝트 연동 시 사용 (지금은 로컬만)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Sentry — 모바일 앱 런타임 에러 로깅
# DSN 은 Sentry 프로젝트 Settings > Client Keys (DSN) 에서 발급받는다.
# 형식: https://<key>@oXXX.ingest.sentry.io/<projectId>
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENV=development

# Sentry sentry-cli (소스맵 업로드 등) — CI/배포 환경에서만 사용. 절대 커밋 금지.
# 다음 두 값은 OAuth/Internal Integration 자격이며 SDK DSN 과 다르다.
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase Edge Functions secrets
# supabase secrets set PORTONE_STORE_ID=... PORTONE_IDENTITY_CHANNEL_KEY=... PORTONE_PAYMENT_CHANNEL_KEY=... PORTONE_API_SECRET=... PHONE_HASH_SALT=...
# 바로 매치 금액은 코드 하드코딩 금지. 스토어/RevenueCat/운영 콘솔 기준값을 Edge Function secret 으로 주입한다.
PORTONE_STORE_ID=
PORTONE_IDENTITY_CHANNEL_KEY=
PORTONE_PAYMENT_CHANNEL_KEY=
PORTONE_API_SECRET=
PHONE_HASH_SALT=
PORTONE_INSTANT_REMATCH_AMOUNT_1=
PORTONE_INSTANT_REMATCH_AMOUNT_3=
PORTONE_INSTANT_REMATCH_AMOUNT_10=

# Mobile public labels. 실제 가격 라벨은 스토어/RevenueCat 콘솔 기준으로 빌드 전에 주입한다.
EXPO_PUBLIC_INSTANT_REMATCH_PRICE_1_LABEL=
EXPO_PUBLIC_INSTANT_REMATCH_PRICE_3_LABEL=
EXPO_PUBLIC_INSTANT_REMATCH_PRICE_10_LABEL=
