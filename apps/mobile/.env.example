# 모바일 앱 실행 전에 이 파일을 apps/mobile/.env 로 복사하세요.
#   cp apps/mobile/.env.example apps/mobile/.env
#
# 아래 값들은 모두 공개되어도 무방한 값입니다:
#   - Supabase 로컬 anon key 는 모든 supabase CLI 설치본이 공유하는 데모 키
#   - Sentry DSN 은 클라이언트 SDK 용 (앱 바이너리에 그대로 포함되는 식별자)
# 따라서 이 파일은 git 에 커밋되어 있고, .env 파일은 gitignore 됩니다.

# --- Supabase (로컬 dev) ---
# `pnpm db:start` 후 `pnpm exec supabase status -o env` 로 키 확인 가능.
# config.toml 의 기본 JWT 시크릿을 그대로 두면 아래 값과 일치합니다.
# 물리 디바이스로 테스트할 땐 127.0.0.1 → 개발 PC LAN IP 로 교체하세요.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# 원격 Supabase로 개발하면서 PortOne 실키를 아직 넣지 않았을 때만 true.
EXPO_PUBLIC_ENABLE_DEV_IDENTITY_BYPASS=false
# RevenueCat/스토어 상품 연결 전 유료 리프레시 흐름을 눌러볼 때만 true.
EXPO_PUBLIC_ENABLE_DEV_PAYMENT_BYPASS=false

# --- Sentry (deai-13/react-native 프로젝트) ---
# DSN 미설정 시 SDK 비활성화 + 콘솔 fallback 으로 동작.
# Sentry 콘솔: https://deai-13.sentry.io/projects/react-native/
EXPO_PUBLIC_SENTRY_DSN=https://3eb2cadbb6b232e459cb5bc962d506e8@o4511291332100096.ingest.us.sentry.io/4511291335049216
EXPO_PUBLIC_SENTRY_ENV=development

# --- PostHog (제품 분석) ---
# 키 미설정 시 SDK 비활성화 + 콘솔 fallback 으로 동작.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 본인확인은 PortOne을 Supabase Edge Function 뒤에서 호출합니다.
# 모바일 앱에는 Supabase URL/anon key만 필요합니다.

# --- RevenueCat / IAP ---
# RevenueCat Dashboard > Project settings > API keys 의 public SDK key.
# 실제 결제 전까지 비워두면 앱은 개발자 결제 완료 버튼만 사용합니다.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# 부스터/바로 매치 IAP. App Store Connect consumable 3종과 RevenueCat package를 연결한 뒤 채우세요.
EXPO_PUBLIC_REVENUECAT_BOOSTER_OFFERING_ID=booster
EXPO_PUBLIC_REVENUECAT_BOOSTER_PACKAGE_ID_1=booster_1
EXPO_PUBLIC_REVENUECAT_BOOSTER_PACKAGE_ID_3=booster_pack3
EXPO_PUBLIC_REVENUECAT_BOOSTER_PACKAGE_ID_10=booster_pack10
EXPO_PUBLIC_REVENUECAT_BOOSTER_PRODUCT_ID_1=booster_instant_rematch_v1
EXPO_PUBLIC_REVENUECAT_BOOSTER_PRODUCT_ID_3=booster_instant_rematch_v1_pack3
EXPO_PUBLIC_REVENUECAT_BOOSTER_PRODUCT_ID_10=booster_instant_rematch_v1_pack10
# 아래 refresh/heart 값은 기존 placeholder 입니다. 부스터 상품과 혼용하지 마세요.
EXPO_PUBLIC_REVENUECAT_REFRESH_OFFERING_ID=refresh
EXPO_PUBLIC_REVENUECAT_REFRESH_PRODUCT_ID=dei_refresh_1
EXPO_PUBLIC_REVENUECAT_HEART_OFFERING_ID=heart
EXPO_PUBLIC_REVENUECAT_HEART_PRODUCT_ID=dei_heart_1

# 채팅 진입 방식 강제 override(개발/실기기 검증용). 'legacy' | 'overlay'.
# 설정 시 PostHog 'chat-overlay-mode' 플래그보다 우선한다(빌드타임 임베드 — 바꾸면 재빌드 필요).
# 미설정(빈 값)이면 PostHog 플래그 → 기본 legacy. 한 디바이스에서 두 모드 모두 보려면
# 이 값을 바꿔가며 두 번 빌드하거나, PostHog 에서 본인 user 를 조건 타겟팅.
EXPO_PUBLIC_CHAT_PRESENTATION=
